---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import fs from 'node:fs';
import path from 'node:path';

interface TreeNode {
  name: string;
  type: 'folder' | 'file';
  path?: string;
  kind?: string;
  children?: TreeNode[];
  count?: number;
}

const PUBLIC_DIR = path.resolve('./public');

function naturalCompare(a: string, b: string) {
  return a.localeCompare(b, undefined, { numeric: true, sensitivity: 'base' });
}

function scanDirectory(dirPath: string, depth = 0): TreeNode[] {
  if (depth > 5) return [];
  if (!fs.existsSync(dirPath)) return [];

  const items = fs.readdirSync(dirPath, { withFileTypes: true });
  const nodes: TreeNode[] = [];

  // Sort natural
  items.sort((a, b) => naturalCompare(a.name, b.name));

  for (const item of items) {
    const fullPath = path.join(dirPath, item.name);
    const relativePath = path.relative(PUBLIC_DIR, fullPath);

    if (item.name.startsWith('.') || item.name === 'node_modules' || item.name === 'common.css' || item.name === 'common.js') continue;

    if (item.isDirectory()) {
      const children = scanDirectory(fullPath, depth + 1);
      if (children.length > 0) {
        const count = countFiles(children);
        nodes.push({
          name: item.name,
          type: 'folder',
          children,
          count
        });
      }
    } else {
      const ext = path.extname(item.name).toLowerCase();
      if (ext === '.html' || ext === '.htm' || ext === '.pdf') {
        nodes.push({
          name: item.name,
          type: 'file',
          path: `/brain-document/${encodeURI(relativePath.replace(/\\/g, '/'))}`,
          kind: ext.substring(1)
        });
      }
    }
  }

  // Sort folders first, then files
  nodes.sort((a, b) => {
    if (a.type !== b.type) {
      return a.type === 'folder' ? -1 : 1;
    }
    return naturalCompare(a.name, b.name);
  });

  return nodes;
}

function countFiles(nodes: TreeNode[]): number {
  let count = 0;
  for (const node of nodes) {
    if (node.type === 'file') {
      count += 1;
    } else if (node.children) {
      count += countFiles(node.children);
    }
  }
  return count;
}

// Build the tree scanning public directory
const subfolders = scanDirectory(PUBLIC_DIR);
const totalDocs = countFiles(subfolders);

// Calculate stats for Dashboard
let totalPdfs = 0;
let totalHtmlDecks = 0;

function calculateStats(nodes: TreeNode[]) {
  for (const node of nodes) {
    if (node.type === 'folder') {
      if (node.children) calculateStats(node.children);
    } else if (node.type === 'file') {
      if (node.kind === 'pdf') {
        totalPdfs++;
      } else {
        totalHtmlDecks++;
      }
    }
  }
}
calculateStats(subfolders);
---

<StarlightPage frontmatter={{ title: "Library", tableOfContents: false }}>
  <div class="sl-markdown-content library-container">
    <p class="library-subtitle">Browse standalone HTML decks and PDFs. Click any item to open it in a new view.</p>

    <!-- Stats Dashboard Section -->
    <div class="stats-dashboard">
      <div class="stat-card">
        <div class="stat-icon-wrapper docs-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="16" y1="13" x2="8" y2="13"></line>
            <line x1="16" y1="17" x2="8" y2="17"></line>
          </svg>
        </div>
        <div class="stat-info">
          <span class="stat-value">{totalDocs}</span>
          <span class="stat-label">Total Files</span>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon-wrapper decks-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"></circle>
            <line x1="2" y1="12" x2="22" y2="12"></line>
            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
          </svg>
        </div>
        <div class="stat-info">
          <span class="stat-value">{totalHtmlDecks}</span>
          <span class="stat-label">Web Decks</span>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-icon-wrapper pdfs-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
            <polyline points="14 2 14 8 20 8"></polyline>
            <line x1="9" y1="15" x2="15" y2="15"></line>
          </svg>
        </div>
        <div class="stat-info">
          <span class="stat-value">{totalPdfs}</span>
          <span class="stat-label">PDF Documents</span>
        </div>
      </div>
    </div>

    <!-- Modern Search bar wrapper -->
    <div class="search-wrapper">
      <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input type="search" id="lib-q" class="lib-search" placeholder="Search library documents..." autocomplete="off">
      <button type="button" id="lib-search-clear" class="search-clear-btn" aria-label="Clear search" style="display: none;">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <!-- Toolbar: Breadcrumbs & View Toggle -->
    <div class="library-toolbar">
      <div class="breadcrumbs" id="lib-breadcrumbs">
        <span class="breadcrumb-item" data-path="">Library</span>
      </div>

      <div class="view-toggle-group">
        <button type="button" id="toggle-grid" class="toggle-btn active" title="Grid View">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="7" height="7"></rect>
            <rect x="14" y="3" width="7" height="7"></rect>
            <rect x="14" y="14" width="7" height="7"></rect>
            <rect x="3" y="14" width="7" height="7"></rect>
          </svg>
          Grid
        </button>
        <button type="button" id="toggle-tree" class="toggle-btn" title="Tree View">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
          Tree
        </button>
      </div>
    </div>

    <!-- 1. Grid Explorer View -->
    <div class="view-container grid-view" id="view-grid">
      {function renderGridCards(nodes: TreeNode[], parentPath = "") {
        const elements: any[] = [];
        
        for (const node of nodes) {
          const currentPath = parentPath ? `${parentPath}/${node.name}` : node.name;
          
          if (node.type === 'folder') {
            elements.push(
              <div class="grid-card folder-card" data-parent={parentPath} data-path={currentPath} data-name={node.name.toLowerCase()} data-type="folder">
                <div class="card-content">
                  <div class="card-icon folder-icon">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                    </svg>
                  </div>
                  <div class="card-info">
                    <h4 class="card-name" data-orig-name={node.name}>{node.name}</h4>
                    <span class="card-meta count-badge">{node.count} items</span>
                  </div>
                </div>
              </div>
            );
            
            if (node.children) {
              elements.push(...renderGridCards(node.children, currentPath));
            }
          } else {
            const extClass = node.kind === 'pdf' ? 'pdf-file' : 'web-file';
            elements.push(
              <div class="grid-card file-card" data-parent={parentPath} data-path={currentPath} data-name={node.name.toLowerCase()} data-type="file">
                <a href={node.path} target="_blank" rel="noopener noreferrer">
                  <div class="card-content">
                    <div class={`card-icon file-icon ${extClass}`}>
                      {node.kind === 'pdf' ? (
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                          <polyline points="14 2 14 8 20 8"></polyline>
                          <line x1="16" y1="13" x2="8" y2="13"></line>
                          <line x1="16" y1="17" x2="8" y2="17"></line>
                        </svg>
                      ) : (
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <circle cx="12" cy="12" r="10"></circle>
                          <line x1="2" y1="12" x2="22" y2="12"></line>
                          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                        </svg>
                      )}
                    </div>
                    <div class="card-info">
                      <h4 class="card-name" data-orig-name={node.name}>{node.name}</h4>
                      <span class={`file-type-badge ${node.kind}`}>{node.kind === 'pdf' ? 'PDF' : 'Web Deck'}</span>
                      <span class="search-path-indicator">{parentPath}</span>
                    </div>
                  </div>
                </a>
              </div>
            );
          }
        }
        
        return elements;
      }(subfolders)}
    </div>

    <!-- 2. Clean List Tree Explorer View -->
    <div class="view-container tree-view hidden" id="view-tree">
      {function renderTree(nodes: TreeNode[], isTop = false) {
        return (
          <ul>
            {nodes.map(node => {
              if (node.type === 'folder') {
                return (
                  <li class="folder-node" data-name={node.name.toLowerCase()}>
                    <details open={isTop} class={isTop ? 'top-level' : ''}>
                      <summary>
                        <span class="chevron-icon">
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="9 18 15 12 9 6"></polyline>
                          </svg>
                        </span>
                        <svg class="ico-folder" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                          <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"></path>
                        </svg>
                        <span class="name" data-orig-name={node.name}>{node.name}</span>
                        <span class="count-badge">{node.count}</span>
                      </summary>
                      {node.children && renderTree(node.children)}
                    </details>
                  </li>
                );
              } else {
                return (
                  <li class="file-node" data-name={node.name.toLowerCase()}>
                    <a href={node.path} target="_blank" rel="noopener noreferrer">
                      <span class="ico">
                        {node.kind === 'pdf' ? (
                          <svg class="ico-file-pdf" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                            <polyline points="14 2 14 8 20 8"></polyline>
                            <line x1="16" y1="13" x2="8" y2="13"></line>
                            <line x1="16" y1="17" x2="8" y2="17"></line>
                          </svg>
                        ) : (
                          <svg class="ico-file-web" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="2" y1="12" x2="22" y2="12"></line>
                            <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                          </svg>
                        )}
                      </span>
                      <span class="name" data-orig-name={node.name}>{node.name}</span>
                    </a>
                  </li>
                );
              }
            })}
          </ul>
        );
      }(subfolders, true)}
    </div>

    <!-- Empty Search Results State -->
    <div class="empty-search-state" id="empty-state" style="display: none;">
      <svg class="empty-icon" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <h3>No documents found</h3>
      <p>We couldn't find any documents matching your query. Please check your spelling or clear the filter.</p>
      <button type="button" id="btn-clear-search" class="clear-search-btn">Reset search filter</button>
    </div>
  </div>
</StarlightPage>

<style>
/* Library Container overrides */
.library-container {
  margin-top: 1rem;
}
.library-subtitle {
  font-size: 1.05rem;
  color: var(--sl-color-text-muted);
  margin-bottom: 2rem;
}

/* Stats Dashboard Widget styles */
.stats-dashboard {
  display: flex;
  gap: 1.25rem;
  margin-bottom: 2rem;
  flex-wrap: wrap;
}
.stat-card {
  flex: 1;
  min-width: 220px;
  display: flex;
  align-items: center;
  gap: 1rem;
  padding: 1.2rem 1.4rem;
  background: var(--sl-color-bg-sidebar);
  border: 1px solid var(--sl-color-hairline);
  border-radius: 14px;
  box-shadow: var(--sl-shadow-sm);
  transition: transform 0.2s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.2s;
}
.stat-card:hover {
  transform: translateY(-2px);
  box-shadow: var(--sl-shadow-md);
}
.stat-icon-wrapper {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  border-radius: 12px;
  flex-shrink: 0;
}
.docs-icon {
  background: rgba(99, 91, 255, 0.08);
  color: #635bff;
}
.decks-icon {
  background: rgba(37, 99, 235, 0.08);
  color: #2563eb;
}
.pdfs-icon {
  background: rgba(220, 38, 38, 0.08);
  color: #dc2626;
}
.stat-info {
  display: flex;
  flex-direction: column;
}
.stat-value {
  font-size: 1.6rem;
  font-weight: 700;
  line-height: 1.15;
  color: var(--sl-color-text);
  font-variant-numeric: tabular-nums;
}
.stat-label {
  font-size: 0.82rem;
  color: var(--sl-color-text-muted);
  font-weight: 500;
  margin-top: 1px;
}

/* Search bar with clear button */
.search-wrapper {
  position: relative;
  margin-bottom: 2rem;
  display: flex;
  align-items: center;
}
.search-icon {
  position: absolute;
  left: 1rem;
  color: var(--sl-color-text-muted);
  pointer-events: none;
  transition: color 0.15s;
}
.lib-search {
  width: 100%;
  padding: 0.75rem 2.8rem 0.75rem 2.6rem;
  font: inherit;
  font-size: 0.95rem;
  background: var(--sl-color-bg-sidebar);
  color: var(--sl-color-text);
  border: 1px solid var(--sl-color-hairline);
  border-radius: 12px;
  outline: none;
  transition: border-color 0.2s, box-shadow 0.2s;
}
.lib-search:focus {
  border-color: var(--sl-color-accent);
  box-shadow: 0 0 0 3px var(--sl-color-accent-low);
}
.search-wrapper:focus-within .search-icon {
  color: var(--sl-color-accent);
}
.search-clear-btn {
  position: absolute;
  right: 0.8rem;
  background: transparent;
  border: none;
  color: var(--sl-color-text-muted);
  cursor: pointer;
  padding: 4px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  transition: background-color 0.15s, color 0.15s;
}
.search-clear-btn:hover {
  background-color: var(--sl-color-gray-6);
  color: var(--sl-color-text);
}

/* Toolbar: Breadcrumbs & View Toggle */
.library-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 1.25rem;
  gap: 1rem;
  flex-wrap: wrap;
  border-bottom: 1px solid var(--sl-color-hairline);
  padding-bottom: 0.85rem;
}
.breadcrumbs {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  font-size: 0.95rem;
  font-weight: 500;
  color: var(--sl-color-text-muted);
}
.breadcrumb-item {
  cursor: pointer;
  transition: color 0.15s;
  padding: 2px 4px;
  border-radius: 4px;
}
.breadcrumb-item:hover {
  color: var(--sl-color-text-accent);
  background-color: var(--sl-color-accent-low);
}
.breadcrumb-item:last-child {
  color: var(--sl-color-text);
  cursor: default;
  font-weight: 600;
}
.breadcrumb-item:last-child:hover {
  color: var(--sl-color-text);
  background-color: transparent;
}
.breadcrumb-separator {
  color: var(--sl-color-hairline);
  user-select: none;
  font-weight: 400;
}

/* View Mode Segmented Controls */
.view-toggle-group {
  display: flex;
  background: var(--sl-color-bg-sidebar);
  border: 1px solid var(--sl-color-hairline);
  border-radius: 10px;
  padding: 3px;
  gap: 2px;
}
.toggle-btn {
  background: transparent;
  border: none;
  border-radius: 7px;
  color: var(--sl-color-text-muted);
  font-size: 0.85rem;
  font-weight: 600;
  padding: 5px 12px;
  display: flex;
  align-items: center;
  gap: 6px;
  cursor: pointer;
  transition: all 0.2s ease;
}
.toggle-btn:hover {
  color: var(--sl-color-text);
  background: var(--sl-color-gray-6);
}
.toggle-btn.active {
  background: var(--sl-color-accent);
  color: white;
}
:root[data-theme='light'] .toggle-btn.active {
  background: var(--sl-color-accent);
  color: white;
}

/* Grid View styling */
.grid-view {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 1.25rem;
}
.grid-card {
  border: 1px solid var(--sl-color-hairline);
  border-radius: 14px;
  background: var(--sl-color-bg-sidebar);
  box-shadow: var(--sl-shadow-sm);
  transition: transform 0.2s cubic-bezier(0.16, 1, 0.3, 1), border-color 0.2s, box-shadow 0.2s;
  overflow: hidden;
  height: 100%;
}
.grid-card:hover {
  transform: translateY(-4px);
  border-color: var(--sl-color-accent);
  box-shadow: var(--sl-shadow-md);
}
.grid-card a {
  text-decoration: none !important;
  color: inherit !important;
  display: block;
}
.grid-card.folder-card {
  cursor: pointer;
}
.card-content {
  display: flex;
  align-items: center;
  gap: 1rem;
  padding: 1.1rem;
}
.card-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  border-radius: 12px;
  flex-shrink: 0;
  transition: background-color 0.15s, color 0.15s;
}
.folder-card:hover .card-icon {
  background-color: #d97706;
  color: white;
}
.file-card:hover .card-icon.pdf-file {
  background-color: #dc2626;
  color: white;
}
.file-card:hover .card-icon.web-file {
  background-color: #2563eb;
  color: white;
}

/* Sub-icon specific backgrounds */
.folder-icon {
  background: rgba(217, 119, 6, 0.08);
  color: #d97706;
}
.file-icon.pdf-file {
  background: rgba(220, 38, 38, 0.08);
  color: #dc2626;
}
.file-icon.web-file {
  background: rgba(37, 99, 235, 0.08);
  color: #2563eb;
}
.card-info {
  display: flex;
  flex-direction: column;
  overflow: hidden;
  width: 100%;
}
.card-name {
  font-size: 0.95rem;
  font-weight: 600;
  line-height: 1.35;
  color: var(--sl-color-text);
  margin: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}
.card-meta {
  font-size: 0.78rem;
  color: var(--sl-color-text-muted);
  margin-top: 2px;
  font-weight: 500;
}

/* Badge tags for format kinds */
.file-type-badge {
  font-size: 0.7rem;
  font-weight: 700;
  padding: 1px 6px;
  border-radius: 6px;
  margin-top: 4px;
  width: max-content;
  text-transform: uppercase;
  letter-spacing: 0.03em;
}
.file-type-badge.pdf {
  background: rgba(220, 38, 38, 0.08);
  color: #dc2626;
  border: 1px solid rgba(220, 38, 38, 0.15);
}
.file-type-badge.html {
  background: rgba(37, 99, 235, 0.08);
  color: #2563eb;
  border: 1px solid rgba(37, 99, 235, 0.15);
}
.search-path-indicator {
  font-size: 0.72rem;
  color: var(--sl-color-text-muted);
  margin-top: 4px;
  font-weight: 500;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  display: none;
}
.grid-view.is-searching .search-path-indicator {
  display: block;
}

/* Tree View styling */
.tree-view {
  border: 1px solid var(--sl-color-hairline);
  border-radius: 14px;
  background: var(--sl-color-bg-sidebar);
  padding: 1.25rem;
  box-shadow: var(--sl-shadow-sm);
}
.tree-view ul {
  list-style: none;
  padding-left: 1.25rem;
  margin: 0;
  border-left: 1px dashed var(--sl-color-hairline);
}
.tree-view > ul {
  padding-left: 0;
  border-left: none;
}
.tree-view li {
  margin: 4px 0;
  position: relative;
}

/* Tree Folder elements */
.tree-view details > summary {
  cursor: pointer;
  user-select: none;
  padding: 6px 10px;
  border-radius: 8px;
  display: flex;
  align-items: center;
  gap: 0.5rem;
  list-style: none;
  color: var(--sl-color-text);
  font-weight: 500;
  font-size: 0.95rem;
  transition: background-color 0.15s, color 0.15s;
}
.tree-view details > summary::-webkit-details-marker,
.tree-view details > summary::marker {
  display: none;
}
.tree-view details > summary:hover {
  background-color: var(--sl-color-gray-6);
}
.chevron-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--sl-color-text-muted);
  transition: transform 0.2s ease;
  flex-shrink: 0;
}
.tree-view details[open] > summary .chevron-icon {
  transform: rotate(90deg);
}

/* Tree icons spacing & colors */
.ico-folder {
  color: #d97706;
  fill: rgba(217, 119, 6, 0.08);
  flex-shrink: 0;
}
.ico-file-pdf {
  color: #dc2626;
  flex-shrink: 0;
}
.ico-file-web {
  color: #2563eb;
  flex-shrink: 0;
}

.tree-view .count-badge {
  margin-left: auto;
  background: var(--sl-color-gray-6);
  border: 1px solid var(--sl-color-hairline);
  color: var(--sl-color-text-muted);
  font-size: 0.72rem;
  padding: 2px 7px;
  border-radius: 99px;
  font-weight: 600;
  flex-shrink: 0;
  font-variant-numeric: tabular-nums;
}

/* Tree files links */
.tree-view .file-node a {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  padding: 6px 10px;
  padding-left: 28px;
  text-decoration: none !important;
  color: var(--sl-color-text) !important;
  border-radius: 8px;
  font-size: 0.92rem;
  transition: background-color 0.15s, color 0.15s;
}
.tree-view .file-node a:hover {
  background-color: var(--sl-color-accent-low);
  color: var(--sl-color-text-accent) !important;
}
.tree-view .ico {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 16px;
  height: 16px;
  color: var(--sl-color-text-muted);
}
.tree-view .file-node a:hover .ico {
  color: var(--sl-color-text-accent);
}

/* Yellow search highlighting */
.search-highlight {
  background-color: rgba(254, 240, 138, 0.7);
  color: #000000;
  border-radius: 2px;
  padding: 0 2px;
  font-weight: 700;
}
:root[data-theme='dark'] .search-highlight {
  background-color: rgba(234, 179, 8, 0.45);
  color: #ffffff;
}

/* Empty Search Results layout */
.empty-search-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 3.5rem 2rem;
  border: 2px dashed var(--sl-color-hairline);
  border-radius: 16px;
  background: var(--sl-color-bg-sidebar);
  margin-top: 1rem;
}
.empty-icon {
  color: var(--sl-color-text-muted);
  margin-bottom: 1.25rem;
}
.empty-search-state h3 {
  font-size: 1.25rem;
  font-weight: 600;
  margin: 0 0 0.5rem;
  color: var(--sl-color-text);
}
.empty-search-state p {
  font-size: 0.95rem;
  color: var(--sl-color-text-muted);
  max-width: 420px;
  margin: 0 0 1.5rem;
  line-height: 1.5;
}
.clear-search-btn {
  background: var(--sl-color-accent);
  color: white;
  border: none;
  border-radius: 8px;
  font-weight: 600;
  font-size: 0.88rem;
  padding: 8px 18px;
  cursor: pointer;
  transition: opacity 0.15s;
}
.clear-search-btn:hover {
  opacity: 0.9;
}

/* Hidden elements */
.hidden {
  display: none !important;
}
</style>

<script>
// Client-side library explorer script
const q = document.getElementById('lib-q') as HTMLInputElement | null;
const clearBtn = document.getElementById('lib-search-clear') as HTMLButtonElement | null;
const viewGrid = document.getElementById('view-grid');
const viewTree = document.getElementById('view-tree');
const emptyState = document.getElementById('empty-state');
const btnClearSearch = document.getElementById('btn-clear-search') as HTMLButtonElement | null;

const toggleGridBtn = document.getElementById('toggle-grid');
const toggleTreeBtn = document.getElementById('toggle-tree');
const breadcrumbsContainer = document.getElementById('lib-breadcrumbs');

const gridCards = document.querySelectorAll('#view-grid .grid-card');
const treeFiles = document.querySelectorAll('#view-tree .file-node');
const treeFolders = document.querySelectorAll('#view-tree .folder-node');

let currentViewMode = localStorage.getItem('lib-view-mode') || 'grid';
let currentPath = "";

// Initialize view mode
function setViewMode(mode: string) {
  currentViewMode = mode;
  localStorage.setItem('lib-view-mode', mode);
  
  if (mode === 'grid') {
    toggleGridBtn?.classList.add('active');
    toggleTreeBtn?.classList.remove('active');
  } else {
    toggleGridBtn?.classList.remove('active');
    toggleTreeBtn?.classList.add('active');
  }
  
  if (q && q.value.trim() !== "") {
    performSearch();
  } else {
    if (emptyState) emptyState.style.display = 'none';
    if (mode === 'grid') {
      viewGrid?.classList.remove('hidden');
      viewTree?.classList.add('hidden');
      updateGridView();
    } else {
      viewGrid?.classList.add('hidden');
      viewTree?.classList.remove('hidden');
      treeFiles.forEach(f => f.classList.remove('hidden'));
      treeFolders.forEach(f => f.classList.remove('hidden'));
    }
  }
}

// Grid Navigation
function updateGridView() {
  const searchVal = q ? q.value.trim().toLowerCase() : "";
  if (searchVal !== "") {
    if (breadcrumbsContainer) breadcrumbsContainer.style.visibility = 'hidden';
    return;
  }
  
  if (breadcrumbsContainer) breadcrumbsContainer.style.visibility = 'visible';
  
  gridCards.forEach(card => {
    const parent = card.getAttribute('data-parent') || "";
    if (parent === currentPath) {
      card.classList.remove('hidden');
    } else {
      card.classList.add('hidden');
    }
  });
  
  renderBreadcrumbs();
}

function renderBreadcrumbs() {
  if (!breadcrumbsContainer) return;
  breadcrumbsContainer.innerHTML = '';
  
  // Library Root item
  const rootSpan = document.createElement('span');
  rootSpan.className = 'breadcrumb-item';
  rootSpan.textContent = 'Library';
  rootSpan.addEventListener('click', () => {
    currentPath = "";
    updateGridView();
  });
  breadcrumbsContainer.appendChild(rootSpan);
  
  if (currentPath !== "") {
    const parts = currentPath.split('/');
    let pathAccumulator = "";
    
    parts.forEach(part => {
      pathAccumulator = pathAccumulator ? `${pathAccumulator}/${part}` : part;
      
      const separator = document.createElement('span');
      separator.className = 'breadcrumb-separator';
      separator.innerHTML = '&nbsp;/&nbsp;';
      breadcrumbsContainer.appendChild(separator);
      
      const itemSpan = document.createElement('span');
      itemSpan.className = 'breadcrumb-item';
      itemSpan.textContent = part;
      const targetPath = pathAccumulator;
      itemSpan.addEventListener('click', () => {
        currentPath = targetPath;
        updateGridView();
      });
      breadcrumbsContainer.appendChild(itemSpan);
    });
  }
}

// Search function
function performSearch() {
  if (!q) return;
  const term = q.value.trim().toLowerCase();
  
  if (clearBtn) clearBtn.style.display = term ? 'block' : 'none';
  
  if (!term) {
    if (emptyState) emptyState.style.display = 'none';
    viewGrid?.classList.remove('is-searching');
    
    if (currentViewMode === 'grid') {
      viewGrid?.classList.remove('hidden');
      viewTree?.classList.add('hidden');
      updateGridView();
    } else {
      viewGrid?.classList.add('hidden');
      viewTree?.classList.remove('hidden');
      treeFiles.forEach(f => f.classList.remove('hidden'));
      treeFolders.forEach(f => f.classList.remove('hidden'));
    }
    
    resetHighlighting();
    return;
  }
  
  let matchesCount = 0;
  
  // GRID SEARCH
  viewGrid?.classList.add('is-searching');
  gridCards.forEach(card => {
    const name = card.getAttribute('data-name') || "";
    const type = card.getAttribute('data-type') || "";
    
    if (type === 'file' && name.includes(term)) {
      card.classList.remove('hidden');
      matchesCount++;
      highlightText(card.querySelector('.card-name'), term);
    } else {
      card.classList.add('hidden');
    }
  });
  
  // TREE SEARCH
  treeFiles.forEach(f => f.classList.add('hidden'));
  treeFolders.forEach(f => f.classList.add('hidden'));
  
  treeFiles.forEach(f => {
    const name = f.getAttribute('data-name') || "";
    if (name.includes(term)) {
      f.classList.remove('hidden');
      highlightText(f.querySelector('.name'), term);
      
      // Expand parents
      let parent = f.parentElement;
      while (parent && parent !== viewTree) {
        if (parent.tagName === 'DETAILS') {
          (parent as HTMLDetailsElement).open = true;
        }
        if (parent.tagName === 'LI' && parent.classList.contains('folder-node')) {
          parent.classList.remove('hidden');
        }
        parent = parent.parentElement;
      }
    }
  });
  
  // Show/Hide Empty State
  const activeMatches = currentViewMode === 'grid' 
    ? matchesCount 
    : document.querySelectorAll('#view-tree .file-node:not(.hidden)').length;
    
  if (activeMatches === 0) {
    if (emptyState) emptyState.style.display = 'block';
    viewGrid?.classList.add('hidden');
    viewTree?.classList.add('hidden');
  } else {
    if (emptyState) emptyState.style.display = 'none';
    if (currentViewMode === 'grid') {
      viewGrid?.classList.remove('hidden');
      viewTree?.classList.add('hidden');
    } else {
      viewGrid?.classList.add('hidden');
      viewTree?.classList.remove('hidden');
    }
  }
}

function highlightText(element: Element | null, term: string) {
  if (!element) return;
  const origName = element.getAttribute('data-orig-name') || element.textContent || "";
  if (!element.getAttribute('data-orig-name')) {
    element.setAttribute('data-orig-name', origName);
  }
  
  const escapedTerm = term.replace(/[-\/\\^$*+?.()|[\]{}]/g, '\\$&');
  const regex = new RegExp(`(${escapedTerm})`, 'gi');
  element.innerHTML = origName.replace(regex, '<mark class="search-highlight">$1</mark>');
}

function resetHighlighting() {
  document.querySelectorAll('[data-orig-name]').forEach(el => {
    el.textContent = el.getAttribute('data-orig-name') || "";
  });
}

// Event Listeners
toggleGridBtn?.addEventListener('click', () => setViewMode('grid'));
toggleTreeBtn?.addEventListener('click', () => setViewMode('tree'));

gridCards.forEach(card => {
  if (card.getAttribute('data-type') === 'folder') {
    card.addEventListener('click', () => {
      currentPath = card.getAttribute('data-path') || "";
      updateGridView();
    });
  }
});

q?.addEventListener('input', performSearch);

clearBtn?.addEventListener('click', () => {
  if (q) {
    q.value = '';
    performSearch();
    q.focus();
  }
});

btnClearSearch?.addEventListener('click', () => {
  if (q) {
    q.value = '';
    performSearch();
  }
});

// Run Initial setup
setViewMode(currentViewMode);
</script>
